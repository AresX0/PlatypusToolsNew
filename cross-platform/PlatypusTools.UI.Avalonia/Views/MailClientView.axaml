<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.MailClientView" x:DataType="vm:MailClientViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="📧 Mail Client (IMAP)" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Watermark="Server" Text="{Binding Server, Mode=TwoWay}" Width="200" Margin="0,0,4,0"/>
            <NumericUpDown Value="{Binding Port, Mode=TwoWay}" Minimum="1" Maximum="65535" Width="100"/>
        </StackPanel>
        <TextBox Grid.Row="2" Watermark="Username" Text="{Binding Username, Mode=TwoWay}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Watermark="Password (app password)" PasswordChar="*" Text="{Binding Password, Mode=TwoWay}" Margin="0,0,0,4"/>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="160" Binding="{Binding Date}"/>
                <DataGridTextColumn Header="From" Width="200" Binding="{Binding From}"/>
                <DataGridTextColumn Header="Subject" Width="*" Binding="{Binding Subject}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="📥 Fetch 25" Command="{Binding FetchCommand}" IsEnabled="{Binding !IsBusy}" Background="#2196F3" Foreground="White"/>
            <TextBlock Text="{Binding Status}" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
