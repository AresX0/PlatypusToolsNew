<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.CredentialManagerView"
             x:DataType="vm:CredentialManagerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🗝 OS Credential Manager" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" Text="{Binding Service, Mode=TwoWay}" Watermark="Service" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" Text="{Binding Account, Mode=TwoWay}" Watermark="Account" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Text="{Binding Secret, Mode=TwoWay}" PasswordChar="●" Watermark="Secret" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="💾 Store" Command="{Binding StoreCommand}" Background="#4CAF50" Foreground="White" Margin="0,0,4,0"/>
            <Button Content="📖 Read" Command="{Binding ReadCommand}" Background="#2196F3" Foreground="White" Margin="0,0,4,0"/>
            <Button Content="🗑 Delete" Command="{Binding DeleteCommand}" Background="#F44336" Foreground="White"/>
        </StackPanel>
        <Border Grid.Row="5" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer>
                <TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="6" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
