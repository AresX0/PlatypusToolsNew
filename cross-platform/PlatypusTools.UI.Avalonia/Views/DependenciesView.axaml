<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.DependenciesView"
             x:DataType="vm:DependenciesViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🔌 External Dependencies" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#2196F3" Foreground="White"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Width="50" Binding="{Binding Mark}"/>
                    <DataGridTextColumn Header="Name" Width="120" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Version" Width="220" Binding="{Binding Version}"/>
                    <DataGridTextColumn Header="Path" Width="*" Binding="{Binding Path}"/>
                    <DataGridTextColumn Header="Install" Width="320" Binding="{Binding InstallHint}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
