<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.GlobalSearchView" x:DataType="vm:GlobalSearchViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🔎 Global Search" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Root" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Root, Mode=TwoWay}"/>
        </DockPanel>
        <TextBox Grid.Row="2" Watermark="Pattern (case-insensitive substring)" Text="{Binding Pattern, Mode=TwoWay}" Margin="0,0,0,4"/>
        <Button Grid.Row="3" Content="🔎 Search" Command="{Binding SearchCommand}" IsEnabled="{Binding !IsBusy}" Background="#2196F3" Foreground="White" HorizontalAlignment="Left"/>
        <ScrollViewer Grid.Row="4" Margin="0,8,0,0"><TextBox Text="{Binding Result}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace"/></ScrollViewer>
    </Grid>
</UserControl>
