<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.WifiPasswordsView"
             x:DataType="vm:WifiPasswordsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="📶 Wi-Fi Passwords" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{Binding PlatformInfo}" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
        <Button Grid.Row="2" Content="📡 List Saved Networks" Command="{Binding ListCommand}" IsEnabled="{Binding !IsRunning}" Background="#2196F3" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Background="#101010">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Output}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11" Foreground="#80FF80" Padding="8"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
