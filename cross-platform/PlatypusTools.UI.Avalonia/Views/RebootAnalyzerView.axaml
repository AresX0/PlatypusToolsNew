<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.RebootAnalyzerView" x:DataType="vm:RebootAnalyzerViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🔁 Reboot Analyzer" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <Button Grid.Row="1" Content="🔄 Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="2"><TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace"/></ScrollViewer>
    </Grid>
</UserControl>
