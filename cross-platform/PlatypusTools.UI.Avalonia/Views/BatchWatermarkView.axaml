<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.BatchWatermarkView"
             x:DataType="vm:BatchWatermarkViewModel">
    <Grid RowDefinitions="Auto,Auto,*,120,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="➕ Add images" Click="OnAdd" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="🗑 Clear" Command="{Binding ClearCommand}" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="▶ Watermark" Command="{Binding RunCommand}" Background="#4CAF50" Foreground="White"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Watermark:" Width="100" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="📄" Click="OnPickWm" Margin="4,0,0,0"/>
                <TextBox Text="{Binding Watermark, Mode=TwoWay}"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="Out folder:" Width="100" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="📁" Click="OnPickOut" Margin="4,0,0,0"/>
                <TextBox Text="{Binding OutputFolder, Mode=TwoWay}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Position:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding Position, Mode=TwoWay}" Width="160"/>
                <TextBlock Text="Padding:" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding Padding, Mode=TwoWay}" Minimum="0" Maximum="200" Width="100"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
            <ListBox ItemsSource="{Binding Inputs}"/>
        </Border>
        <Border Grid.Row="3" Background="#101010" Padding="8" Margin="0,8,0,0">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding Output}" Foreground="#80FF80" FontFamily="Cascadia Code,Consolas,monospace"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
