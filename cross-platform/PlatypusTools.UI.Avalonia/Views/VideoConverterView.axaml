<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.VideoConverterView"
             x:DataType="vm:VideoConverterViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🎬 Video Converter" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{Binding FFmpegStatus}" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
            <Button Grid.Column="0" Content="📂 Input" Click="OnPickInput" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Input, Mode=TwoWay}" Watermark="Input video"/>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
            <Button Grid.Column="0" Content="💾 Output" Click="OnPickOutput" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Output, Mode=TwoWay}" Watermark="Auto if blank"/>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset, Mode=TwoWay}" Width="220" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" Content="▶ Convert" Command="{Binding ConvertCommand}" IsEnabled="{Binding !IsRunning}" Background="#4CAF50" Foreground="White" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="⏹" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}"/>
        </DockPanel>
        <Border Grid.Row="5" BorderBrush="Gray" BorderThickness="1" Background="#101010">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Log}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="10" Foreground="#80FF80" Padding="6"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
