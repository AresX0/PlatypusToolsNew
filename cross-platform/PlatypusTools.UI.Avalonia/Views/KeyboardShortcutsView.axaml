<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.KeyboardShortcutsView"
             x:DataType="vm:KeyboardShortcutsViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="⌨ Keyboard Shortcuts" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Keys" Width="220" Binding="{Binding Keys}"/>
                    <DataGridTextColumn Header="Action" Width="*" Binding="{Binding Action}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
