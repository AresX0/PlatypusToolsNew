<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.FileCleanerView" x:DataType="vm:FileCleanerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🧽 File Cleaner" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Root" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Root, Mode=TwoWay}"/>
        </DockPanel>
        <TextBox Grid.Row="2" Watermark="Patterns (semi-colon)" Text="{Binding Patterns, Mode=TwoWay}" Margin="0,0,0,4"/>
        <CheckBox Grid.Row="3" Content="Dry run" IsChecked="{Binding DryRun, Mode=TwoWay}" Margin="0,0,0,4"/>
        <Button Grid.Row="4" Content="🚀 Run" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" Background="#FF9800" Foreground="White" HorizontalAlignment="Left"/>
        <ScrollViewer Grid.Row="5"><TextBox Text="{Binding Result}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace"/></ScrollViewer>
    </Grid>
</UserControl>
