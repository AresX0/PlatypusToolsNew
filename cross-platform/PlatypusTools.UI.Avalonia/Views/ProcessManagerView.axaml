<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ProcessManagerView"
             x:DataType="vm:ProcessManagerViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="🔄 Refresh" Command="{Binding RefreshCommand}" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="⏹ Kill Selected" Command="{Binding KillCommand}" Background="#F44336" Foreground="White" Margin="0,0,8,0"/>
            <TextBox Text="{Binding Filter, Mode=TwoWay}" Watermark="Filter by name…"/>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Width="70" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Memory" Width="100" Binding="{Binding MemoryDisplay}"/>
                    <DataGridTextColumn Header="Threads" Width="80" Binding="{Binding Threads}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
