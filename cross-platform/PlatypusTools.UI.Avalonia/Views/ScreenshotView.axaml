<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ScreenshotView"
             x:DataType="vm:ScreenshotViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Output:" Width="80" VerticalAlignment="Center"/>
                <TextBox Text="{Binding OutputPath, Mode=TwoWay}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Delay (s):" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding DelaySeconds, Mode=TwoWay}" Minimum="0" Maximum="60" Width="100"/>
            </StackPanel>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="📸 Capture" Command="{Binding CaptureCommand}" Background="#4CAF50" Foreground="White"/>
        </DockPanel>
        <Border Grid.Row="2" Background="#101010" Padding="8">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding Output}" Foreground="#80FF80" FontFamily="Cascadia Code,Consolas,monospace"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
