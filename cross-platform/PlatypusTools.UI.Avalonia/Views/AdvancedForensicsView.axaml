<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.AdvancedForensicsView" x:DataType="vm:AdvancedForensicsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🔬 Advanced Forensics" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 File" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding File, Mode=TwoWay}"/>
        </DockPanel>
        <Button Grid.Row="2" Content="🔬 Analyze" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}" Background="#4CAF50" Foreground="White" HorizontalAlignment="Left"/>
        <ScrollViewer Grid.Row="3"><TextBox Text="{Binding Result}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace"/></ScrollViewer>
    </Grid>
</UserControl>
