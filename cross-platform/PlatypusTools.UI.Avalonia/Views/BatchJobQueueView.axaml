<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.BatchJobQueueView"
             x:DataType="vm:BatchJobQueueViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="📥 Batch Job Queue" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="🚀 Run Queue" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" Background="#4CAF50" Foreground="White" Margin="4,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="🗑 Clear" Command="{Binding ClearCommand}" Margin="4,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="➕ Add" Command="{Binding AddCommand}" Margin="4,0,0,0"/>
            <TextBox Text="{Binding Command, Mode=TwoWay}" Watermark="ls -la / Get-ChildItem / etc."/>
        </DockPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="State" Width="100" Binding="{Binding State}"/>
                    <DataGridTextColumn Header="Exit" Width="60" Binding="{Binding ExitCode}"/>
                    <DataGridTextColumn Header="Command" Width="*" Binding="{Binding Command}"/>
                    <DataGridTextColumn Header="Started" Width="160" Binding="{Binding Started}"/>
                    <DataGridTextColumn Header="Finished" Width="160" Binding="{Binding Finished}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
