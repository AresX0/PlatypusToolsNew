<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.PluginMarketplaceView" x:DataType="vm:PluginMarketplaceViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🛒 Plugin Marketplace" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="🔄 Fetch" Command="{Binding FetchCommand}" IsEnabled="{Binding !IsBusy}" Background="#2196F3" Foreground="White" Margin="4,0,0,0"/>
            <TextBox Watermark="Registry URL" Text="{Binding RegistryUrl, Mode=TwoWay}"/>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Plugins}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Version" Width="100" Binding="{Binding Version}"/>
                <DataGridTextColumn Header="URL" Width="*" Binding="{Binding Url}"/>
                <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
