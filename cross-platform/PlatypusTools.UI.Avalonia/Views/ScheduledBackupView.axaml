<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ScheduledBackupView"
             x:DataType="vm:ScheduledBackupViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="📦 Scheduled Backup" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Source" Click="OnPickSrcClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Source, Mode=TwoWay}"/>
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Dest" Click="OnPickDstClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding DestDir, Mode=TwoWay}"/>
        </DockPanel>
        <TextBox Grid.Row="3" Text="{Binding ArchiveBase, Mode=TwoWay}" Watermark="archive base name" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="🚀 Run Now" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" Background="#4CAF50" Foreground="White" Margin="0,0,4,0"/>
            <Button Content="⏰ Schedule Daily" Command="{Binding ScheduleCommand}" Background="#2196F3" Foreground="White"/>
        </StackPanel>
        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
