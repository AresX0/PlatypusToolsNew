<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.IntuneBackupView"
             x:DataType="vm:IntuneBackupViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="☁ Intune Backup (cross-platform)" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Get token: https://developer.microsoft.com/graph/graph-explorer (sign in, copy access token)." Foreground="Gray" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" Watermark="Bearer access token" Text="{Binding AccessToken, Mode=TwoWay}" PasswordChar="*" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Output" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding OutputFolder, Mode=TwoWay}"/>
        </DockPanel>
        <Button Grid.Row="4" Content="☁ Backup Intune" Command="{Binding BackupCommand}" IsEnabled="{Binding !IsBusy}" Background="#2196F3" Foreground="White" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
