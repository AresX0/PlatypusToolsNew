<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ThemeBuilderView" x:DataType="vm:ThemeBuilderViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🎨 Theme Builder" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Accent #RRGGBB:" VerticalAlignment="Center" Margin="0,0,4,0" Width="160"/>
            <TextBox Text="{Binding Accent, Mode=TwoWay}" Width="120"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Background:" VerticalAlignment="Center" Margin="0,0,4,0" Width="160"/>
            <TextBox Text="{Binding Background, Mode=TwoWay}" Width="120"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Foreground:" VerticalAlignment="Center" Margin="0,0,4,0" Width="160"/>
            <TextBox Text="{Binding Foreground, Mode=TwoWay}" Width="120"/>
        </StackPanel>
        <Button Grid.Row="4" Content="🪄 Generate" Command="{Binding GenerateCommand}" Background="#9C27B0" Foreground="White" HorizontalAlignment="Left"/>
        <ScrollViewer Grid.Row="5" Margin="0,8,0,0"><TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace"/></ScrollViewer>
    </Grid>
</UserControl>
