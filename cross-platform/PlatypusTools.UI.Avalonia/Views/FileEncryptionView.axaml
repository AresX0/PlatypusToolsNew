<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.FileEncryptionView"
             x:DataType="vm:FileEncryptionViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🔐 File Encryption (AES-256-GCM)" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
            <Button Grid.Column="0" Content="📂 Input" Click="OnPickInput" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Input, Mode=TwoWay}"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
            <Button Grid.Column="0" Content="💾 Output" Click="OnPickOutput" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Output, Mode=TwoWay}" Watermark="Auto if blank"/>
        </Grid>
        <TextBox Grid.Row="3" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" Watermark="Password" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="🔒 Encrypt" Command="{Binding EncryptCommand}" Background="#4CAF50" Foreground="White"/>
            <Button Content="🔓 Decrypt" Command="{Binding DecryptCommand}" Background="#2196F3" Foreground="White"/>
        </StackPanel>
        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="Gray"/>
    </Grid>
</UserControl>
