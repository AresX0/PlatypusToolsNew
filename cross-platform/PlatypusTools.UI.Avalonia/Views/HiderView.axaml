<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.HiderView"
             x:DataType="vm:HiderViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🙈 Hider" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Folder" Click="OnPickFolderClicked" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="📄 File" Click="OnPickFileClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Path, Mode=TwoWay}"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="🙈 Hide" Command="{Binding HideCommand}" Background="#9C27B0" Foreground="White" Margin="0,0,4,0"/>
            <Button Content="👀 Show" Command="{Binding ShowCommand}" Background="#2196F3" Foreground="White"/>
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1">
            <ListBox ItemsSource="{Binding Recents}"/>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
