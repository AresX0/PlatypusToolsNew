<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.AudioPlayerView"
             x:DataType="vm:AudioPlayerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🎵 Audio Player" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Open File…" Click="OnOpenClicked" />
            <Button Content="▶ Play" Command="{Binding PlayCommand}" />
            <Button Content="⏸ Pause" Command="{Binding PauseCommand}" />
            <Button Content="⏹ Stop" Command="{Binding StopCommand}" />
            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="12,0,4,0" />
            <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                    Width="160" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding Position}"
                     Height="6" Margin="0,0,0,8" />

        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
            <StackPanel Margin="12" Spacing="6">
                <TextBlock Text="{Binding TrackName}" FontWeight="Bold" />
                <TextBlock Text="LibVLCSharp backend (cross-platform)." Foreground="Gray" FontSize="11" />
                <TextBlock Text="Linux: requires `libvlc` installed (apt install vlc / dnf install vlc)."
                           Foreground="Gray" FontSize="11" />
                <TextBlock Text="macOS: bundled via VideoLAN.LibVLC.Mac." Foreground="Gray" FontSize="11" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="Gray" />
    </Grid>
</UserControl>
