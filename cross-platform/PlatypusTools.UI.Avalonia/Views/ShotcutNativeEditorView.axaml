<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ShotcutNativeEditorView"
             x:DataType="vm:ShotcutNativeEditorViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🎥 Shotcut Editor" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 File" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Input, Mode=TwoWay}"/>
        </DockPanel>
        <Button Grid.Row="2" Content="🚀 Launch Shotcut" Command="{Binding LaunchCommand}" Background="#4CAF50" Foreground="White" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
