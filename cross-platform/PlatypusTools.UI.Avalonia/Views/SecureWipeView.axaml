<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.SecureWipeView"
             x:DataType="vm:SecureWipeViewModel">
    <StackPanel Spacing="10">
        <TextBlock Text="🧨 Secure Wipe" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Overwrites a file with random bytes (configurable passes), then deletes it. Cannot be undone." Foreground="Gray" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Content="📂 File" Click="OnPick" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Path, Mode=TwoWay}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Passes:" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding Passes, Mode=TwoWay}" Minimum="1" Maximum="35" Width="100"/>
            <Button Content="🧨 WIPE" Command="{Binding WipeCommand}" IsEnabled="{Binding !IsRunning}" Background="#F44336" Foreground="White"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="Gray"/>
    </StackPanel>
</UserControl>
