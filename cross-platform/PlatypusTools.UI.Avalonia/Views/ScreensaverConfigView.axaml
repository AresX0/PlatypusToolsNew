<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ScreensaverConfigView"
             x:DataType="vm:ScreensaverConfigViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🌙 Screensaver Config" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Idle minutes:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <NumericUpDown Value="{Binding IdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="240" Width="120"/>
        </StackPanel>
        <CheckBox Grid.Row="2" Content="Lock on resume" IsChecked="{Binding LockOnResume, Mode=TwoWay}" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Image folder" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding ImageFolder, Mode=TwoWay}"/>
        </DockPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Interval (s):" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <NumericUpDown Value="{Binding IntervalSeconds, Mode=TwoWay}" Minimum="1" Maximum="600" Width="120"/>
        </StackPanel>
        <CheckBox Grid.Row="5" Content="Shuffle" IsChecked="{Binding Shuffle, Mode=TwoWay}" Margin="0,0,0,4"/>
        <Button Grid.Row="6" Content="💾 Save" Command="{Binding SaveCommand}" Background="#4CAF50" Foreground="White" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="7" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
