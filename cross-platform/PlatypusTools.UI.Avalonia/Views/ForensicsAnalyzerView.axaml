<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.ForensicsAnalyzerView"
             x:DataType="vm:ForensicsAnalyzerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🔬 Forensics Analyzer" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Pick" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Input, Mode=TwoWay}"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Min len:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <NumericUpDown Value="{Binding MinStrings, Mode=TwoWay}" Minimum="2" Maximum="64" Width="80" Margin="0,0,8,0"/>
            <TextBlock Text="Max strings:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <NumericUpDown Value="{Binding MaxStrings, Mode=TwoWay}" Minimum="10" Maximum="50000" Width="120" Margin="0,0,8,0"/>
            <Button Content="🚀 Analyze" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}" Background="#4CAF50" Foreground="White"/>
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer>
                <TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
