<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.QrCodeView"
             x:DataType="vm:QrCodeViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🔳 QR Code Generator" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="💾 Save" Click="OnSaveClicked" Margin="4,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="🚀 Generate" Command="{Binding GenerateCommand}" Background="#4CAF50" Foreground="White" Margin="4,0,0,0"/>
            <TextBox Text="{Binding Text, Mode=TwoWay}" Watermark="https://… or any text"/>
        </DockPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12">
            <Image Source="{Binding Image}" Width="320" Height="320" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
