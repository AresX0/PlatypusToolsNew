<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.UpdateCheckerView" x:DataType="vm:UpdateCheckerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="⬆ Update Checker" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" Watermark="GitHub repo (owner/name)" Text="{Binding Repo, Mode=TwoWay}" Margin="0,0,0,4"/>
        <Button Grid.Row="2" Content="🔍 Check" Command="{Binding CheckCommand}" IsEnabled="{Binding !IsBusy}" Background="#2196F3" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="3" Text="{Binding LatestTag, StringFormat='Latest: {0}'}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="4" Text="{Binding LatestUrl}" Foreground="#2196F3"/>
        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
