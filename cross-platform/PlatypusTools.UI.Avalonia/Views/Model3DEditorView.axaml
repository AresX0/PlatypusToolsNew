<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.Model3DEditorView"
             x:DataType="vm:Model3DEditorViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🧊 3D Editor Launcher" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Model" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Input, Mode=TwoWay}"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="🧊 Blender" Command="{Binding BlenderCommand}" Margin="0,0,4,0"/>
            <Button Content="📐 FreeCAD" Command="{Binding FreecadCommand}" Margin="0,0,4,0"/>
            <Button Content="🕸 MeshLab" Command="{Binding MeshlabCommand}" Margin="0,0,4,0"/>
            <Button Content="🧱 OpenSCAD" Command="{Binding OpenScadCommand}"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
