<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.RemoteDesktopView"
             x:DataType="vm:RemoteDesktopViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🖥 Remote Desktop / SSH" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" Text="{Binding Host, Mode=TwoWay}" Watermark="host.example.com" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" Text="{Binding User, Mode=TwoWay}" Watermark="user (optional)" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol, Mode=TwoWay}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4"/>
        <Button Grid.Row="4" Content="🚀 Connect" Command="{Binding ConnectCommand}" Background="#4CAF50" Foreground="White" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
