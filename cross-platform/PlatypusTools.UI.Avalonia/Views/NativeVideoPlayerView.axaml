<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.NativeVideoPlayerView"
             x:DataType="vm:NativeVideoPlayerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🎬 Native Video Player" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 File" Click="OnPickClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding File, Mode=TwoWay}"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="▶ OS Default" Command="{Binding PlayCommand}" Background="#4CAF50" Foreground="White" Margin="0,0,4,0"/>
            <Button Content="▶ VLC" Command="{Binding PlayVlcCommand}" Margin="0,0,4,0"/>
            <Button Content="▶ mpv" Command="{Binding PlayMpvCommand}"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
