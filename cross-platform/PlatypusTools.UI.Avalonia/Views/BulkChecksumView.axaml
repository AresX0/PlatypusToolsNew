<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.BulkChecksumView"
             x:DataType="vm:BulkChecksumViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🔢 Bulk Checksum" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Pick" Click="OnPickClicked" Margin="0,0,4,0"/>
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm, Mode=TwoWay}" Width="100" Margin="0,0,4,0"/>
            <CheckBox DockPanel.Dock="Left" Content="Recurse" IsChecked="{Binding Recurse, Mode=TwoWay}" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" Content="🔍 Compute" Command="{Binding ComputeCommand}" IsEnabled="{Binding !IsRunning}" Background="#4CAF50" Foreground="White" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="⏹" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Right" Content="💾 Export Manifest" Click="OnExportClicked"/>
            <TextBox Text="{Binding Root, Mode=TwoWay}"/>
        </DockPanel>
        <ProgressBar Grid.Row="2" Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,2,0,8"/>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hash" Width="320" Binding="{Binding Hash}"/>
                    <DataGridTextColumn Header="Size" Width="100" Binding="{Binding SizeDisplay}"/>
                    <DataGridTextColumn Header="Path" Width="*" Binding="{Binding Path}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
