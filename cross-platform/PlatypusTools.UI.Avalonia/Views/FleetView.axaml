<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.FleetView" x:DataType="vm:FleetViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🚀 Fleet View" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="➕ Add" Command="{Binding AddCommand}" Margin="4,0,0,0"/>
            <TextBox DockPanel.Dock="Left" Watermark="Host" Text="{Binding NewHost, Mode=TwoWay}" Width="200" Margin="0,0,4,0"/>
            <TextBox Watermark="User (optional)" Text="{Binding NewUser, Mode=TwoWay}"/>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Hosts}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Host" Width="200" Binding="{Binding Host}"/>
                <DataGridTextColumn Header="User" Width="120" Binding="{Binding User}"/>
                <DataGridCheckBoxColumn Header="Up" Width="60" Binding="{Binding Reachable}"/>
                <DataGridTextColumn Header="Uptime / SSH" Width="*" Binding="{Binding Uptime}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="📡 Probe" Command="{Binding ProbeCommand}" IsEnabled="{Binding !IsBusy}" Background="#2196F3" Foreground="White"/>
            <TextBlock Text="{Binding Status}" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
