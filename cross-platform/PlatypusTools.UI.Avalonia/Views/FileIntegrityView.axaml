<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.FileIntegrityView"
             x:DataType="vm:FileIntegrityViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="🛡 File Integrity Verifier" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📄 Manifest" Click="OnPickManifestClicked" Margin="0,0,4,0"/>
            <TextBox Text="{Binding ManifestPath, Mode=TwoWay}"/>
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Base Dir" Click="OnPickBaseClicked" Margin="0,0,4,0"/>
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm, Mode=TwoWay}" Width="100" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="✅ Verify" Command="{Binding VerifyCommand}" IsEnabled="{Binding !IsBusy}" Background="#4CAF50" Foreground="White"/>
            <TextBox Text="{Binding BaseDir, Mode=TwoWay}"/>
        </DockPanel>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Verdict" Width="100" Binding="{Binding Verdict}"/>
                    <DataGridTextColumn Header="Expected" Width="220" Binding="{Binding Expected}"/>
                    <DataGridTextColumn Header="Actual" Width="220" Binding="{Binding Actual}"/>
                    <DataGridTextColumn Header="Path" Width="*" Binding="{Binding Path}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
