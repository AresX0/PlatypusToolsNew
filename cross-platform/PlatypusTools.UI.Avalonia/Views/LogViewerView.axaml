<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.LogViewerView"
             x:DataType="vm:LogViewerViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="📜 Log Viewer" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Pick" Click="OnPickClicked" Margin="0,0,4,0"/>
            <NumericUpDown DockPanel.Dock="Left" Value="{Binding TailLines, Mode=TwoWay}" Minimum="50" Maximum="100000" Increment="100" Width="120" Margin="0,0,4,0"/>
            <TextBox DockPanel.Dock="Left" Text="{Binding Filter, Mode=TwoWay}" Watermark="Filter…" Width="160" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="🔄 Load" Command="{Binding LoadCommand}" Background="#2196F3" Foreground="White" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Path, Mode=TwoWay}"/>
        </DockPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer>
                <TextBox Text="{Binding Content}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11" Background="#111" Foreground="#DDD"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
