<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.TreeMapDiskView"
             x:DataType="vm:TreeMapDiskViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="📊 Disk Tree-Map" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="📂 Root" Click="OnPickClicked" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Right" Content="🚀 Scan" Command="{Binding ScanCommand}" IsEnabled="{Binding !IsBusy}" Background="#4CAF50" Foreground="White" Margin="4,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="⏹ Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Margin="4,0,0,0"/>
            <TextBox Text="{Binding Root, Mode=TwoWay}"/>
        </DockPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
            <ListBox ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,120,80">
                            <Border Grid.Column="0" Background="#2196F3" CornerRadius="3" Margin="0,2" HorizontalAlignment="Left"
                                    Width="{Binding Percent}" MinHeight="20"/>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Pretty}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:0.0}%}" VerticalAlignment="Center" Foreground="Gray"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
