<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatypusTools.UI.Avalonia.ViewModels"
             x:Class="PlatypusTools.UI.Avalonia.Views.EmptyFolderScannerView"
             x:DataType="vm:EmptyFolderScannerViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="📭 Empty Folder Scanner" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="📂 Pick" Click="OnPickClicked" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="🔍 Scan" Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" Background="#4CAF50" Foreground="White" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="⏹" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Right" Content="🗑 Delete All Empty" Command="{Binding DeleteAllCommand}" Background="#F44336" Foreground="White"/>
            <TextBox Text="{Binding Root, Mode=TwoWay}"/>
        </DockPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
            <ListBox ItemsSource="{Binding EmptyFolders}"/>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
